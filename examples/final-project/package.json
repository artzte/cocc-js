{
  "name": "vam-art-browser",
  "version": "1.0.0",
  "description": "Browse and search the Victoria and Albert Museum collection",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "navigo": "^8.11.1"
  }
}
