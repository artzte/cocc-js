    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.6",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
