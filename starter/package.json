{
  "name": "cis133js-starter",
  "version": "1.0.0",
  "description": "Starter kit for CIS 133JS — Introduction to JavaScript",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
